PORT=4173
HOST=127.0.0.1
WINTICKET_DATA_DIR=./data
# Public HTTPS origin is required when running behind a production reverse proxy.
WINTICKET_ORIGIN=http://127.0.0.1:4173
# Used only on the first start when no administrator exists. Never commit credentials.
WINTICKET_ADMIN_USERNAME=
WINTICKET_ADMIN_PASSWORD=
